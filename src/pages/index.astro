---
import BaseLayout from '../layouts/BaseLayout.astro';
import TissageCardAnim from '../components/TissageCardAnim.svelte';
import PointsCardAnim from '../components/PointsCardAnim.svelte';
import CocotteCardAnim from '../components/CocotteCardAnim.svelte';

const tools = [
  { name: "Tissage Papier", slug: "tissage", desc: "Patron de tissage généré par bruit de Perlin. Armures textiles, export PDF.", href: "/outils/tissage", available: true, cats: ["popular","build"], img: "img-tissage" },
  { name: "Points à relier", slug: "points", desc: "Dessinez un tracé, générez les points numérotés. Export PDF A4.", href: "/outils/points-a-relier", available: true, cats: ["popular","draw"], img: "img-points" },
  { name: "Cocotte en papier", slug: "cocotte", desc: "Cocotte personnalisée : couleurs, chiffres et messages cachés. Export PDF.", href: "/outils/cocotte", available: true, cats: ["popular","build","play"], img: "img-cocotte" },
  { name: "Coloriage Génératif", slug: "coloriage", desc: "Motifs géométriques aléatoires à colorier. Mandalas, pavages, formes.", href: "#", available: false, cats: ["draw"], img: "img-coloriage" },
  { name: "Labyrinthe", slug: "labyrinthe", desc: "Labyrinthes générés algorithmiquement. Plusieurs niveaux de difficulté.", href: "#", available: false, cats: ["play"], img: "img-labyrinthe" },
  { name: "Mots mêlés", slug: "mots", desc: "Grilles de mots cachés personnalisables. Thèmes et tailles au choix.", href: "#", available: false, cats: ["play"], img: "img-mots" },
  { name: "Mobile Papier", slug: "mobile", desc: "Patron avec calcul d'équilibre et instructions de montage.", href: "#", available: false, cats: ["build"], img: "img-mobile" },
  { name: "Affiche Générative", slug: "affiche", desc: "Impression d'une affiche unique, motifs algorithmiques.", href: "#", available: false, cats: ["draw"], img: "img-affiche" },
  { name: "Boîte Origami", slug: "origami", desc: "Patrons de boîtes dépliables avec motifs génératifs.", href: "#", available: false, cats: ["build"], img: "img-origami" },
];

const categories = [
  { id: "all", label: "Tous" },
  { id: "popular", label: "Populaires" },
  { id: "draw", label: "Dessiner / Colorier" },
  { id: "build", label: "Découper / Construire" },
  { id: "play", label: "Jouer" },
];

const gallery = [
  { title: "Tissage Satin", color: "var(--yellow)", pattern: "grid" },
  { title: "Sergé croisé", color: "var(--red)", pattern: "hlines" },
  { title: "Toile bicolore", color: "var(--blue)", pattern: "dots" },
  { title: "Losange texturé", color: "#2ab54e", pattern: "crosshatch" },
  { title: "Perlin dense", color: "#7b2ad4", pattern: "grid" },
  { title: "Natté large", color: "var(--yellow)", pattern: "crosshatch" },
];
---

<BaseLayout title="Design génératif & papier — Outils gratuits" description="Créez des objets papier uniques grâce au design génératif. Tissage, points à relier, coloriages — patrons PDF gratuits prêts à imprimer.">
  <!-- HERO -->
  <section class="hero bg-grid" id="hero">
    <div class="hero-label">Design génératif & papier — pliio.fr</div>
    <h1>Objets papier<br>d'<em>algorithmes</em></h1>
    <p class="hero-sub">
      Pliio crée des outils gratuits de génération d'objets papier uniques.
      Tissage, jeux, affiches — chaque motif est unique, prêt à fabriquer.
    </p>
    <div class="hero-actions">
      <a href="#outils" class="btn-primary-hero">
        Découvrir les outils
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v10M4 9l4 4 4-4"/></svg>
      </a>
    </div>
    <div class="hero-scroll">
      <span>Explorer</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- OUTILS -->
  <section class="tools-section" id="outils">
    <div class="container">
      <div class="section-header">
        <h2>Les <em>outils</em></h2>
      </div>

      <div class="cat-tabs" role="tablist">
        {categories.map((cat, i) => (
          <button
            class={`cat-tab ${i === 0 ? 'active' : ''}`}
            data-cat={cat.id}
            role="tab"
          >
            {cat.label}
          </button>
        ))}
      </div>

      <div class="tools-grid">
        {tools.map(tool => (
          <a
            href={tool.available ? tool.href : undefined}
            class={`product-card ${!tool.available ? 'disabled' : ''}`}
            data-cats={tool.cats.join(',')}
          >
            <div class={`card-img ${tool.img}`}>
              {tool.slug === 'tissage' && <TissageCardAnim client:visible overlay />}
              {tool.slug === 'points' && <PointsCardAnim client:visible overlay />}
              {tool.slug === 'cocotte' && <CocotteCardAnim client:visible overlay />}
            </div>
            <div class="card-body">
              <div class="card-tag">{tool.available ? 'Disponible' : 'Bientôt'}</div>
              <div class="card-title">{tool.name}</div>
              <div class="card-desc">{tool.desc}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="gallery-section bg-dots" id="galerie">
    <div class="container">
      <div class="section-header">
        <h2>La <em>galerie</em></h2>
      </div>
    </div>
    <div class="gallery-track">
      {gallery.map(item => (
        <div class="gallery-card">
          <div class="gallery-img" style={`--gc: ${item.color}`} data-pattern={item.pattern}></div>
          <div class="gallery-label">{item.title}</div>
        </div>
      ))}
      {gallery.map(item => (
        <div class="gallery-card" aria-hidden="true">
          <div class="gallery-img" style={`--gc: ${item.color}`} data-pattern={item.pattern}></div>
          <div class="gallery-label">{item.title}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- MANIFESTE -->
  <section class="manifesto-section" id="manifeste">
    <div class="container">
      <div class="manifesto-head">
        <div class="label">Manifeste</div>
        <h2>Du code au <em>papier</em></h2>
        <p>
          Pliio transforme des algorithmes en objets tangibles.
          Chaque outil génère un motif unique que vous imprimez, découpez et assemblez de vos mains.
        </p>
      </div>

      <div class="pictos-grid">
        <div class="picto-item">
          <div class="picto-icon picto-code">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 12 6 24 16 36"/><polyline points="32 12 42 24 32 36"/><line x1="28" y1="8" x2="20" y2="40"/></svg>
          </div>
          <strong>Génératif</strong>
          <span>Chaque motif naît d'un algorithme — bruit de Perlin, fractales, grammaires.</span>
        </div>
        <div class="picto-item">
          <div class="picto-icon picto-scissors">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="36" r="5"/><circle cx="34" cy="36" r="5"/><line x1="40" y1="8" x2="17" y2="32"/><line x1="8" y1="8" x2="31" y2="32"/></svg>
          </div>
          <strong>Tangible</strong>
          <span>Exportez en PDF, imprimez, découpez. Le résultat se touche et s'accroche.</span>
        </div>
        <div class="picto-item">
          <div class="picto-icon picto-hand">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 32V14a3 3 0 0 1 6 0v12"/><path d="M24 24v-4a3 3 0 0 1 6 0v6"/><path d="M30 26v-2a3 3 0 0 1 6 0v8a12 12 0 0 1-24 4V22a3 3 0 0 1 6 0v10"/></svg>
          </div>
          <strong>Artisanal</strong>
          <span>L'assemblage est un geste humain. Le code fait le motif, vous faites l'objet.</span>
        </div>
        <div class="picto-item">
          <div class="picto-icon picto-unique">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 4v8"/><path d="M24 36v8"/><path d="M9.86 9.86l5.66 5.66"/><path d="M32.48 32.48l5.66 5.66"/><path d="M4 24h8"/><path d="M36 24h8"/><path d="M9.86 38.14l5.66-5.66"/><path d="M32.48 15.52l5.66-5.66"/><circle cx="24" cy="24" r="6"/></svg>
          </div>
          <strong>Unique</strong>
          <span>Aucune pièce n'est identique. Un ID, une graine, un objet singulier.</span>
        </div>
      </div>

      <div class="manifesto-cta">
        <a href="/a-propos" class="btn">
          En savoir plus
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Category filter tabs
  document.querySelectorAll('.cat-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const cat = tab.dataset.cat;
      document.querySelectorAll('.product-card').forEach(card => {
        const cats = card.dataset.cats?.split(',') || [];
        if (cat === 'all' || cats.includes(cat)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 8rem 3rem 7rem;
    position: relative;
  }

  .hero-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.2s forwards;
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 900px;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.4s forwards;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--blue);
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-soft);
    max-width: 480px;
    margin-top: 2rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.6s forwards;
  }

  .hero-actions {
    margin-top: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.8s forwards;
  }

  .btn-primary-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1rem 2.5rem;
    background: var(--text);
    color: #fff;
    border-radius: 3px;
    transition: all 0.4s var(--ease);
  }

  .btn-primary-hero:hover {
    background: var(--blue);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(26, 92, 255, 0.25);
  }

  .btn-primary-hero svg {
    width: 16px;
    height: 16px;
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.5rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 1s forwards;
  }

  .hero-scroll span {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: var(--border);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -40px;
    left: 0;
    width: 1px;
    height: 40px;
    background: var(--red);
    animation: scrollDown 2s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0% { top: -40px; }
    100% { top: 40px; }
  }

  /* ========== OUTILS ========== */
  .tools-section {
    padding-bottom: 6rem;
    position: relative;
    z-index: 1;
    box-shadow: 0 -20px 60px rgba(0,0,0,0.08);
    background: var(--bg);
  }

  .cat-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .cat-tab {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.5rem 1.2rem;
    border: 1.5px solid var(--border);
    border-radius: 100px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    transition: all 0.25s var(--ease);
  }

  .cat-tab:hover {
    border-color: var(--text);
    color: var(--text);
  }

  .cat-tab.active {
    background: var(--text);
    border-color: var(--text);
    color: #fff;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .product-card.disabled {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
  }

  /* Card image textures */
  .img-tissage {
    background: linear-gradient(135deg, var(--yellow) 0%, #FF9E2C 35%, var(--red) 70%, #C41A2A 100%);
  }
  .img-tissage::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.06) 1px, transparent 1px);
    background-size: 12px 12px;
  }

  .img-points {
    background: linear-gradient(160deg, #D0DFFF 0%, var(--blue) 100%);
  }
  .img-points::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.15) 2px, transparent 2px);
    background-size: 20px 20px;
  }

  .img-cocotte {
    background: linear-gradient(135deg, var(--yellow) 0%, #FF9E2C 50%, var(--red) 100%);
  }
  .img-cocotte::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(45deg, rgba(255,255,255,0.1) 25%, transparent 25%, transparent 75%, rgba(255,255,255,0.1) 75%),
      linear-gradient(-45deg, rgba(255,255,255,0.1) 25%, transparent 25%, transparent 75%, rgba(255,255,255,0.1) 75%);
    background-size: 100% 100%;
  }

  .img-coloriage {
    background: linear-gradient(135deg, #FFE0F0, #FF6EB4 80%);
  }
  .img-coloriage::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-conic-gradient(rgba(255,255,255,0.12) 0% 25%, transparent 0% 50%);
    background-size: 24px 24px;
  }

  .img-labyrinthe {
    background: linear-gradient(135deg, #C5F0C5, #2ab54e 80%);
  }
  .img-labyrinthe::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.05) 2px, transparent 2px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.05) 2px, transparent 2px);
    background-size: 16px 16px;
  }

  .img-mots {
    background: linear-gradient(135deg, #D0F5E0, #34A853 80%);
  }
  .img-mots::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 14px, rgba(0,0,0,0.04) 14px, rgba(0,0,0,0.04) 15px);
  }

  .img-mobile {
    background: linear-gradient(160deg, #D0DFFF 0%, #7b2ad4 100%);
  }
  .img-mobile::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 3px, transparent 3px);
    background-size: 28px 28px;
  }

  .img-affiche {
    background: linear-gradient(160deg, #FFF8DC, var(--yellow));
  }
  .img-affiche::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(0, 0, 0, 0.04) 10px, rgba(0, 0, 0, 0.04) 11px);
  }

  .img-origami {
    background: linear-gradient(135deg, #F0DDE0, var(--red) 80%);
  }
  .img-origami::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(-45deg, transparent, transparent 12px, rgba(255,255,255,0.08) 12px, rgba(255,255,255,0.08) 13px),
      repeating-linear-gradient(45deg, transparent, transparent 12px, rgba(255,255,255,0.08) 12px, rgba(255,255,255,0.08) 13px);
  }

  /* ========== GALERIE ========== */
  .gallery-section {
    padding: 0 0 6rem;
    overflow: hidden;
    background-color: var(--bg-warm);
  }

  .gallery-track {
    display: flex;
    gap: 1.25rem;
    animation: galleryScroll 30s linear infinite;
    width: max-content;
    padding: 0 1.25rem;
  }

  .gallery-track:hover {
    animation-play-state: paused;
  }

  @keyframes galleryScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .gallery-card {
    flex-shrink: 0;
    width: 260px;
  }

  .gallery-img {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 8px;
    background: var(--gc);
    position: relative;
    overflow: hidden;
  }

  .gallery-img[data-pattern="grid"]::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .gallery-img[data-pattern="dots"]::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.12) 2px, transparent 2px);
    background-size: 18px 18px;
  }

  .gallery-img[data-pattern="hlines"]::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg, transparent, transparent 7px, rgba(255,255,255,0.06) 7px, rgba(255,255,255,0.06) 8px
    );
  }

  .gallery-img[data-pattern="crosshatch"]::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.06) 10px, rgba(255,255,255,0.06) 11px),
      repeating-linear-gradient(-45deg, transparent, transparent 10px, rgba(255,255,255,0.06) 10px, rgba(255,255,255,0.06) 11px);
  }

  .gallery-label {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--text-soft);
    text-align: center;
  }

  /* ========== MANIFESTE ========== */
  .manifesto-section {
    padding: 6rem 0;
    background-color: var(--bg);
  }

  .manifesto-head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 4rem;
  }

  .manifesto-head .label {
    margin-bottom: 1rem;
  }

  .manifesto-head h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .manifesto-head h2 em {
    font-style: italic;
    color: var(--blue);
  }

  .manifesto-head p {
    color: var(--text-soft);
    line-height: 1.7;
  }

  .pictos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .picto-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .picto-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.4rem;
  }

  .picto-icon svg {
    width: 32px;
    height: 32px;
  }

  .picto-code { background: rgba(26, 92, 255, 0.08); color: var(--blue); }
  .picto-scissors { background: rgba(230, 48, 36, 0.08); color: var(--red); }
  .picto-hand { background: rgba(255, 208, 0, 0.12); color: #B5920A; }
  .picto-unique { background: rgba(42, 181, 78, 0.08); color: #2ab54e; }

  .picto-item strong {
    font-family: var(--serif);
    font-size: 1.1rem;
  }

  .picto-item span {
    font-size: 0.85rem;
    color: var(--text-soft);
    line-height: 1.5;
    max-width: 200px;
  }

  .manifesto-cta {
    text-align: center;
    margin-top: 3rem;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .pictos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 7rem 1.5rem 3rem;
    }

    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cat-tabs {
      gap: 0.35rem;
    }

    .cat-tab {
      font-size: 0.72rem;
      padding: 0.4rem 0.9rem;
    }

    .gallery-card {
      width: 200px;
    }

    .manifesto-section {
      padding: 4rem 0;
    }

    .pictos-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }

    .pictos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
