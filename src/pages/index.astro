---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil">
  <!-- HERO -->
  <section class="hero bg-grid">
    <div class="hero-label">Design génératif & papier — pixtil.fr</div>
    <h1>Objets papier<br>d'<em>algorithmes</em></h1>
    <p class="hero-sub">
      Pixtil crée des outils gratuits de génération d'objets papier uniques.
      Tissage, mobiles, affiches — chaque motif est unique, prêt à fabriquer.
    </p>
    <div class="hero-actions">
      <a href="/outils/tissage" class="btn-primary-hero">
        Essayer le tissage
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
    </div>
    <div class="hero-scroll">
      <span>Découvrir</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee-wrap bg-grid">
    <div class="marquee">
      <span class="marquee-item">Tissage Papier</span>
      <span class="marquee-item">Design Génératif</span>
      <span class="marquee-item">Patrons PDF</span>
      <span class="marquee-item">Pièces Uniques</span>
      <span class="marquee-item">Feuille d'Or</span>
      <span class="marquee-item">Open Source</span>
      <span class="marquee-item">Tissage Papier</span>
      <span class="marquee-item">Design Génératif</span>
      <span class="marquee-item">Patrons PDF</span>
      <span class="marquee-item">Pièces Uniques</span>
      <span class="marquee-item">Feuille d'Or</span>
      <span class="marquee-item">Open Source</span>
    </div>
  </div>

  <!-- OUTILS -->
  <section class="tools-section bg-grid">
    <div class="container">
      <div class="section-header">
        <h2>Les <em>outils</em></h2>
        <a href="/outils/tissage" class="section-link">Tous les outils &rarr;</a>
      </div>
      <div class="tools-grid">
        <a href="/outils/tissage" class="product-card featured">
          <div class="card-img img-tissage"></div>
          <div class="card-body card-body-featured">
            <div class="card-tag">Disponible</div>
            <div class="card-title">Tissage Papier</div>
            <div class="card-desc">Patron de tissage généré par bruit de Perlin. Armures textiles classiques, export PDF prêt à imprimer.</div>
          </div>
        </a>

        <a href="/outils/points-a-relier" class="product-card">
          <div class="card-img img-points"></div>
          <div class="card-body">
            <div class="card-tag">Disponible</div>
            <div class="card-title">Points à relier</div>
            <div class="card-desc">Dessinez un tracé, générez les points numérotés. Export PDF A4.</div>
          </div>
        </a>

        <div class="product-card disabled">
          <div class="card-img img-affiche"></div>
          <div class="card-body">
            <div class="card-tag">Bientôt</div>
            <div class="card-title">Affiche Générative</div>
            <div class="card-desc">Impression directe d'une affiche unique, motifs algorithmiques.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTE -->
  <section class="manifesto-section bg-hlines">
    <div class="manifesto-inner container">
      <div class="manifesto-text">
        <div class="label">Manifeste</div>
        <h2>Algorithme,<br>artisanat &<br><em>geste humain</em></h2>
        <p>
          Pixtil est né de la rencontre entre le code génératif et les arts du papier.
          Chaque outil transforme un algorithme en objet tangible — un motif que vous
          imprimez, découpez et assemblez de vos mains.
        </p>
        <p>Le résultat est toujours unique. Le processus est toujours le vôtre.</p>
        <a href="/a-propos" class="btn">
          En savoir plus
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
      <div class="manifesto-visual">
        <div class="mani-tile mt-1"></div>
        <div class="mani-tile mt-2"></div>
        <div class="mani-tile mt-3"></div>
        <div class="mani-tile mt-4"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 8rem 3rem 4rem;
    position: relative;
  }

  .hero-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.2s forwards;
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 900px;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.4s forwards;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--blue);
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-soft);
    max-width: 480px;
    margin-top: 2rem;
    line-height: 1.7;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.6s forwards;
  }

  .hero-actions {
    margin-top: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 0.8s forwards;
  }

  .btn-primary-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1rem 2.5rem;
    background: var(--text);
    color: #fff;
    border-radius: 3px;
    transition: all 0.4s var(--ease);
  }

  .btn-primary-hero:hover {
    background: var(--blue);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(26, 92, 255, 0.25);
  }

  .btn-primary-hero svg {
    width: 16px;
    height: 16px;
  }

  .hero-scroll {
    position: absolute;
    bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease) 1s forwards;
  }

  .hero-scroll span {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: var(--border);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -40px;
    left: 0;
    width: 1px;
    height: 40px;
    background: var(--red);
    animation: scrollDown 2s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0% { top: -40px; }
    100% { top: 40px; }
  }

  /* Marquee */
  .marquee-wrap {
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .marquee {
    display: flex;
    gap: 3rem;
    animation: marquee 25s linear infinite;
    width: max-content;
  }

  .marquee-item {
    font-family: var(--serif);
    font-size: 1rem;
    white-space: nowrap;
    color: var(--text-soft);
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .marquee-item::after {
    content: '\u25C6';
    font-size: 0.4rem;
    color: var(--red);
  }

  /* Tools Grid */
  .tools-section {
    padding-bottom: 6rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .product-card.featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .product-card.featured .card-img {
    aspect-ratio: auto;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .card-body-featured {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.5rem;
    background: linear-gradient(to top, rgba(17, 17, 17, 0.85) 0%, rgba(17, 17, 17, 0) 100%);
    color: #fff;
  }

  .card-body-featured .card-tag {
    color: rgba(255, 255, 255, 0.7);
  }

  .card-body-featured .card-title {
    font-size: 2rem;
    color: #fff;
  }

  .card-body-featured .card-desc {
    color: rgba(255, 255, 255, 0.6);
  }

  .product-card.disabled {
    opacity: 0.5;
    cursor: default;
    pointer-events: none;
  }

  /* Card image textures */
  .img-tissage {
    background: linear-gradient(135deg, var(--yellow) 0%, #FF9E2C 35%, var(--red) 70%, #C41A2A 100%);
  }

  .img-tissage::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.06) 1px, transparent 1px);
    background-size: 12px 12px;
  }

  .img-points {
    background: linear-gradient(160deg, #D0DFFF 0%, var(--blue) 100%);
  }

  .img-points::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.15) 2px, transparent 2px);
    background-size: 20px 20px;
  }

  .img-affiche {
    background: linear-gradient(160deg, #FFF8DC, var(--yellow));
  }

  .img-affiche::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(0, 0, 0, 0.04) 10px, rgba(0, 0, 0, 0.04) 11px);
  }

  /* Manifeste */
  .manifesto-section {
    background-color: var(--bg-warm);
    padding: 8rem 0;
  }

  .manifesto-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .manifesto-text .label {
    margin-bottom: 1.5rem;
  }

  .manifesto-text h2 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: 1.5rem;
  }

  .manifesto-text h2 em {
    font-style: italic;
    color: var(--blue);
  }

  .manifesto-text p {
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.8;
    max-width: 480px;
    margin-bottom: 1rem;
  }

  .manifesto-text .btn {
    margin-top: 1.5rem;
  }

  .manifesto-visual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .mani-tile {
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 3/4;
  }

  .mani-tile:nth-child(2) { transform: translateY(2rem); }
  .mani-tile:nth-child(4) { transform: translateY(2rem); }

  .mt-1 {
    background: var(--blue);
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.12) 2px, transparent 2px);
    background-size: 18px 18px;
  }

  .mt-2 {
    background: var(--yellow);
    background-image: repeating-linear-gradient(45deg, transparent, transparent 8px, rgba(0, 0, 0, 0.06) 8px, rgba(0, 0, 0, 0.06) 9px);
  }

  .mt-3 {
    background: var(--red);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .mt-4 {
    background: linear-gradient(160deg, #D8D8CE, #C5C5BA);
    background-image:
      repeating-linear-gradient(-45deg, transparent, transparent 12px, rgba(0, 0, 0, 0.04) 12px, rgba(0, 0, 0, 0.04) 13px),
      repeating-linear-gradient(45deg, transparent, transparent 12px, rgba(0, 0, 0, 0.04) 12px, rgba(0, 0, 0, 0.04) 13px);
  }

  @media (max-width: 1024px) {
    .tools-grid {
      grid-template-columns: 1fr 1fr;
    }

    .product-card.featured {
      grid-column: span 2;
      grid-row: span 1;
    }

    .product-card.featured .card-img {
      position: relative;
      aspect-ratio: 16/9;
      height: auto;
    }

    .manifesto-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 7rem 1.5rem 3rem;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .product-card.featured {
      grid-column: span 1;
    }

    .manifesto-section {
      padding: 5rem 0;
    }

    .manifesto-visual {
      display: none;
    }
  }
</style>
