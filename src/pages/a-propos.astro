---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="À propos" description="L'histoire de Pixtil — du tissage industriel jacquard au design génératif papier.">
  <section class="about-hero bg-grid">
    <div class="container">
      <div class="label">Le Studio</div>
      <h1>Du métier jacquard<br>au <em>papier</em></h1>
    </div>
  </section>

  <section class="about-content">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <p class="lead">
            Pixtil est né d'un parcours atypique — à la croisée du code génératif,
            de l'artisanat textile et des arts plastiques.
          </p>
          <p>
            Expérience de production pièce unique sur métier jacquard industriel,
            sérigraphie à motifs génératifs, céramique —
            chaque discipline nourrit une pratique singulière où l'algorithme
            devient geste et matière.
          </p>
          <p>
            Les outils Pixtil rendent ce savoir-faire accessible.
            Chaque visiteur peut générer un objet papier unique,
            le télécharger et le fabriquer de ses mains.
            Le code fait le motif. Vous faites l'objet.
          </p>
        </div>

        <div class="about-skills">
          <h2>Compétences</h2>
          <div class="skill-list">
            <div class="skill-item">
              <div class="skill-dot" style="background: var(--blue);"></div>
              <div>
                <strong>Design génératif</strong>
                <span>Processing, p5.js, openFrameworks</span>
              </div>
            </div>
            <div class="skill-item">
              <div class="skill-dot" style="background: var(--red);"></div>
              <div>
                <strong>Tissage textile</strong>
                <span>Métier jacquard industriel, production pièce unique</span>
              </div>
            </div>
            <div class="skill-item">
              <div class="skill-dot" style="background: var(--yellow);"></div>
              <div>
                <strong>Sérigraphie</strong>
                <span>Objets sérigraphiés à motifs génératifs</span>
              </div>
            </div>
            <div class="skill-item">
              <div class="skill-dot" style="background: var(--bg-warm);"></div>
              <div>
                <strong>Céramique</strong>
                <span>Pratique personnelle</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-block">
        <h2>Contact</h2>
        <p>
          Pour toute question, proposition d'atelier ou commande de pièce originale :
          <a href="mailto:contact@pixtil.fr">contact@pixtil.fr</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: 8rem 0 4rem;
    text-align: center;
  }

  .about-hero .label {
    margin-bottom: 1.5rem;
  }

  .about-hero h1 {
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1.05;
  }

  .about-hero h1 em {
    font-style: italic;
    color: var(--blue);
  }

  .about-content {
    padding: 4rem 0 6rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .about-text .lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .about-text p {
    color: var(--text-soft);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .about-skills h2 {
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .skill-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
  }

  .skill-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.3rem;
  }

  .skill-item strong {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 0.2rem;
  }

  .skill-item span {
    font-size: 0.82rem;
    color: var(--text-soft);
  }

  .contact-block {
    max-width: 1000px;
    margin: 4rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .contact-block h2 {
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .contact-block p {
    color: var(--text-soft);
    line-height: 1.7;
  }

  .contact-block a {
    color: var(--blue);
    font-weight: 500;
  }

  .contact-block a:hover {
    color: var(--red);
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: 7rem 0 3rem;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
