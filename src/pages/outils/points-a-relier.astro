---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PointsRelierApp from '../../components/PointsRelierApp.svelte';
import ToolGuide from '../../components/ToolGuide.svelte';

const guideSteps = `<ol>
  <li><strong>Tracez</strong> le contour de votre dessin avec l'outil Tracé — ce sont ces lignes qui seront transformées en points numérotés à relier.</li>
  <li><strong>Décorez</strong> avec l'outil Décor pour ajouter des détails (yeux, motifs, textures…) qui apparaîtront directement sur le résultat final.</li>
  <li><strong>Ajustez</strong> le nombre de points, leur taille et la numérotation. Les étoiles colorées indiquent les jonctions entre vos différents traits.</li>
  <li><strong>Exportez en PDF</strong> au format A4, prêt à imprimer — le fichier contient les points, les numéros et vos décors.</li>
</ol>`;

const guideMaterial = `<ul>
  <li>Papier standard ou épais (80–160 g)</li>
  <li>Crayons de couleur, feutres ou peinture pour colorier le résultat</li>
  <li>Optionnel : papier calque pour reporter le dessin</li>
</ul>
<p style="margin-top:1rem; font-size:0.82rem; color:var(--text-soft);">
  <strong>Navigation :</strong> <kbd>Molette</kbd> zoomer · <kbd>Espace</kbd>+glisser déplacer · <kbd>Ctrl+Z</kbd> annuler
</p>`;

const guideTabs = [
  { label: 'Comment créer', content: guideSteps },
  { label: 'Matériel recommandé', content: guideMaterial },
];
---

<BaseLayout title="Points à relier — Créer un jeu personnalisé" description="Dessinez un tracé libre et l'outil génère automatiquement les points numérotés. Ajoutez des décors, exportez en PDF A4 prêt à imprimer.">
  <section class="tool-header">
    <div class="container">
      <h1>Points à <em>relier</em></h1>
      <p>Dessinez librement un tracé et l'outil distribue automatiquement les points numérotés le long du contour. Ajoutez des décors, puis exportez le tout en PDF prêt à imprimer.</p>
    </div>
  </section>

  <section class="tool-guide-section">
    <div class="container">
      <ToolGuide tabs={guideTabs} client:load />
    </div>
  </section>

  <section class="tool-app">
    <div class="container">
      <PointsRelierApp client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .tool-header {
    padding: calc(var(--nav-height) + 2rem) 0 1.5rem;
    text-align: center;
  }

  .tool-header h1 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-bottom: 0.6rem;
    color: var(--text);
  }

  .tool-header h1 em {
    font-style: italic;
    color: var(--blue);
  }

  .tool-header p {
    color: var(--text-soft);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .tool-guide-section {
    padding: 0 0 1rem;
  }

  .tool-app {
    padding: 0 0 3rem;
  }
</style>
