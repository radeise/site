---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TissageApp from '../../components/TissageApp.svelte';
import ToolGuide from '../../components/ToolGuide.svelte';

const guideSteps = `<ol>
  <li><strong>Générez</strong> un motif en cliquant sur l'aperçu ou en ajustant les réglages à gauche (format, épaisseur, identifiant).</li>
  <li><strong>Explorez</strong> les variations — chaque identifiant produit un motif unique. Changez-le pour découvrir de nouveaux entrelacs.</li>
  <li><strong>Exportez les patrons PDF</strong> — vous obtenez 4 fichiers : le patron de chaîne (à retourner après découpe), le guide de trame, un aperçu du résultat et une fiche récapitulative.</li>
  <li><strong>Imprimez</strong> sur du papier épais (160 à 200 g), type Canson ou Clairefontaine.</li>
  <li><strong>Découpez</strong> les bandes en suivant les repères imprimés, puis <strong>tissez</strong> en entrecroisant les bandes selon le motif.</li>
  <li><strong>Finitions</strong> — collez les bords, et si vous le souhaitez, ajoutez de la peinture ou de la feuille d'or.</li>
</ol>`;

const guideMaterial = `<ul>
  <li>Papier cartonné 160–200 g (Canson, Clairefontaine…)</li>
  <li>Cutter et règle métallique</li>
  <li>Tapis de découpe</li>
  <li>Colle en bâton ou colle blanche</li>
  <li>Optionnel : feuille d'or, peinture acrylique, vernis</li>
</ul>
<p style="margin-top:1rem; font-size:0.82rem; color:var(--text-soft);">
  <strong>Raccourcis :</strong> <kbd>s</kbd> exporter les PDF · <kbd>clic</kbd> sur l'aperçu pour un nouveau motif
</p>`;

const guideTabs = [
  { label: 'Comment réaliser', content: guideSteps },
  { label: 'Matériel recommandé', content: guideMaterial },
];
---

<BaseLayout title="Tissage papier — Générateur de motifs" description="Créez des motifs de tissage papier uniques grâce au design génératif. Exportez les patrons PDF prêts à imprimer, découpez et tissez.">
  <section class="tool-header">
    <div class="container">
      <h1>Tissage <em>papier</em></h1>
      <p>Créez des motifs de tissage uniques — chaque combinaison de réglages produit un entrelacs différent. Exportez les patrons, imprimez-les et fabriquez votre tissage en papier.</p>
    </div>
  </section>

  <section class="tool-guide-section">
    <div class="container">
      <ToolGuide tabs={guideTabs} client:load />
    </div>
  </section>

  <section class="tool-app">
    <div class="container">
      <TissageApp client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .tool-header {
    padding: calc(var(--nav-height) + 2rem) 0 1.5rem;
    text-align: center;
  }

  .tool-header h1 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-bottom: 0.6rem;
    color: var(--text);
  }

  .tool-header h1 em {
    font-style: italic;
    color: var(--blue);
  }

  .tool-header p {
    color: var(--text-soft);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .tool-guide-section {
    padding: 0 0 1rem;
  }

  .tool-app {
    padding: 0 0 3rem;
  }
</style>
